DISCORD_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=optional-guild-id-filter

# Inline cap for text attachments on live delivery, in bytes (default 5120).
# A text attachment over this many actual bytes is not rendered into the
# agent's context; it degrades to a name+size+URL note instead. 0 disables
# text auto-inlining entirely; values above 262144 (256KiB) clamp to that
# absolute ceiling; malformed or negative values log an error and fall back
# to the default. Raising the cap intentionally restores the old
# always-inline behavior. Images are unaffected — they inline as native
# image blocks under their own ceilings.
#DISCORD_ATTACHMENT_INLINE_MAX_BYTES=5120
