DISCORD_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=optional-guild-id-filter

# Inline cap for text attachments on live delivery, in bytes (default 5120).
# A text attachment over this many actual bytes is not rendered into the
# agent's context; it degrades to a name+size+URL note instead. 0 disables
# text auto-inlining entirely; values above 262144 (256KiB) clamp to that
# absolute ceiling; malformed or negative values log an error and fall back
# to the default. Raising the cap intentionally restores the old
# always-inline behavior. Images are unaffected — they inline as native
# image blocks under their own ceilings.
#DISCORD_ATTACHMENT_INLINE_MAX_BYTES=5120

# Reserved-reaction projection policy (issue #21): path to a JSON file naming
# reaction emojis that must never be shown to the model (they are reserved
# for classifier signaling). The glyphs go in the FILE, never in env/recipe
# values — resolved-config logs would reproduce them. Schema:
#   { "version": 1, "customEmojiIds": ["<snowflake>"],
#     "unicodeExact": ["<emoji>"], "unicodeFamilies": ["<base emoji>"] }
# customEmojiIds match by id; unicodeExact match after NFC + presentation-
# selector normalization; unicodeFamilies also cover skin-tone variants of
# the base. Unset = no protection (a startup line says so). Set but
# missing/malformed = FAIL CLOSED: all model-visible reactions suppressed
# until the file is repaired. The file hot-reloads; a bad rewrite keeps the
# last-known-good policy.
#DISCORD_RESERVED_REACTIONS_FILE=/path/to/reserved-reactions.json
